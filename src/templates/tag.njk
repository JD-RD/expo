{% extends "layouts/base.njk" %}

{% block content %}
<h1>#{{ tag }}</h1>
<p class="tag-count">{{ concepts.length }} concept{% if concepts.length > 1 %}s{% endif %}</p>

{% if concepts and concepts.length > 0 %}
<div class="concept-list">
  {% for c in concepts %}
  <a href="{{ c.url }}" class="concept-card">
    <span class="type-badge type-{{ c.type | replace(' ', '') }}">{{ c.type }}</span>
    <strong>{{ c.title }}</strong>
    {% if c.description %}
    <p>{{ c.description }}</p>
    {% endif %}
    <p class="result-bundle">📦 {{ c.bundle }}</p>
  </a>
  {% endfor %}
</div>
{% endif %}
{% endblock %}
