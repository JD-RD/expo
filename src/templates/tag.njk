{% extends "layouts/base.njk" %}

{% block content %}
<h1>#{{ tag }}</h1>
<p class="tag-count">{{ concepts.length }} concept{% if concepts.length > 1 %}s{% endif %}</p>

{% if concepts and concepts.length > 0 %}
<div class="concept-list">
  {% for c in concepts %}
  <a href="{{ c.url }}" class="concept-card">
    <span class="type-badge type-{{ c.type | replace(' ', '') }}">{{ c.type }}</span>
    <strong>{{ c.title }}</strong>
    {% if c.description %}
    <p>{{ c.description }}</p>
    {% endif %}
    <p class="result-bundle">📦 {{ c.bundle }}</p>
  </a>
  {% endfor %}
</div>
{% endif %}

{% if wines and wines.length > 0 %}
<h2>🍷 Tous les vins à la SAQ ({{ wines.length }})</h2>
<div class="markdown-body">
<table>
  <thead>
    <tr>
      <th>Vin</th>
      <th>Famille</th>
      <th>Prix</th>
      <th>Sucre</th>
      <th>Alcool</th>
      <th>Dispo</th>
    </tr>
  </thead>
  <tbody>
    {% for w in wines %}
    <tr>
      <td><a href="{{ w.url }}" target="_blank" rel="noopener">{{ w.name }}</a></td>
      <td>{{ w.famille }}</td>
      <td>{{ w.prix }}</td>
      <td>{{ w.sucre }}</td>
      <td>{{ w.alcool }}</td>
      <td>{{ w.dispo }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
</div>
{% endif %}
{% endblock %}
